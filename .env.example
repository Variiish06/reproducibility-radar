# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token — needs repo:read scope to clone public repos
GITHUB_TOKEN=ghp_...

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the orchestrator
DATABASE_URL=postgresql://radar:changeme@postgres:5432/radar

# ── SMTP (weekly digest emails) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=Reproducibility Radar <noreply@example.com>

# ── Orchestrator tuning (optional overrides) ──────────────────────────────────
# Max parallel sandbox runs (default: 3)
SANDBOX_CONCURRENCY=3
# Wall-clock timeout per sandbox in seconds (default: 1800)
SANDBOX_TIMEOUT_SECONDS=1800
# Docker base image for sandboxes
SANDBOX_BASE_IMAGE=radar-python311-cpu:latest
