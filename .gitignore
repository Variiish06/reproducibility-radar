# ====================================================================
# Reproducibility Radar — .gitignore
# ====================================================================

# --- Secrets and environment ----------------------------------------
# NEVER commit these. .env.example is the only env file that should be tracked.
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*.crt
secrets/
credentials.json

# --- Python (orchestrator/) -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
MANIFEST

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.cache/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter (in case anyone explores in notebooks)
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Node / Next.js (frontend/) -------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
out/
.vercel/
.turbo/

# Production build
*.tsbuildinfo
next-env.d.ts

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Docker ---------------------------------------------------------
# We keep Dockerfiles and compose configs, but ignore local overrides
docker-compose.override.yml
docker-compose.local.yml
*.dockerignore.local

# --- Database / Alembic ---------------------------------------------
# DO commit alembic/versions/*.py — they are the migration history.
# Ignore only local DB dumps and backups.
*.sqlite
*.sqlite3
*.db
postgres-data/
pgdata/
*.sql.gz
*.dump

# --- Reproducibility Radar runtime artifacts ------------------------
# These are generated by the orchestrator at runtime — they should
# never be committed (they grow forever and contain external repos).

# Per-paper sandbox working directories
work/
sandbox-work/
orchestrator/work/

# Captured logs from sandbox runs
logs/
orchestrator/logs/
*.log
!docs/**/*.log   # but keep any intentional example logs in docs/

# Cloned repos from ArXiv papers (these can be huge)
cloned-repos/
orchestrator/cloned-repos/

# Cached PDFs and ArXiv metadata
pdf-cache/
arxiv-cache/
.cache/

# Generated DOCX digests (the weekly outputs)
digests/
*.docx
!docs/**/*.docx   # but keep any intentional templates in docs/

# Claude API call logs (if you log them for debugging)
claude-logs/
prompt-traces/

# --- Editors and OS ------------------------------------------------
# IDE / editor configs — opinion varies on whether to commit .vscode.
# Default is to ignore; uncomment the !.vscode/settings.json line if
# the team agrees on a shared workspace config.
.vscode/
# !.vscode/settings.json
# !.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Misc -----------------------------------------------------------
# Backup files
*.bak
*.backup
*.orig
*.rej

# Local notes that shouldn't be public
NOTES.md
TODO.local.md
scratch/
tmp/
